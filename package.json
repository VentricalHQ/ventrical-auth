{
  "name": "@ventrical/auth",
  "version": "0.0.0",
  "description": "OIDC authentication for Ventrical services",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express/index.d.ts",
      "import": "./dist/express/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js"
    },
    "./hono": {
      "types": "./dist/hono/index.d.ts",
      "import": "./dist/hono/index.js"
    },
    "./fastify": {
      "types": "./dist/fastify/index.d.ts",
      "import": "./dist/fastify/index.js"
    },
    "./pg": {
      "types": "./dist/pg/index.d.ts",
      "import": "./dist/pg/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/pg/migrations','dist/pg/migrations',{recursive:true})\"",
    "check:dist": "node scripts/check-dist.mjs",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "express": "^5",
    "fastify": "^5",
    "hono": "^4",
    "next": ">=14"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "openid-client": "6.8.8",
    "pg": "^8.23.1",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "express": "^5.3.0",
    "fastify": "^5.12.5",
    "hono": "^4.13.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
